{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXUS",
  "version": "0.1.0",
  "identifier": "com.nexus.assistant",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "sh -c '[ -f ../frontend/package.json ] && npm --prefix ../frontend run dev || npm --prefix frontend run dev'",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "trayIcon": {
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "id": "NEXUS-tray"
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' wss: https: ipc: http://ipc.localhost; media-src 'self' blob: data: https: http:; img-src 'self' data: blob: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; font-src 'self' data:; worker-src 'self' blob:",
      "capabilities": ["main-cap", "sidebar-cap", "architect-cap"],
      "assetProtocol": { "enable": false }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "resources": [
      "resources/oww/**/*",
      "resources/server/stt_server.py",
      "resources/server/nlu_server.py",
      "resources/server/nlu/requirements.txt",
      "resources/server/nlu/model/nexus_nlu.onnx",
      "resources/server/nlu/model/nexus_nlu.onnx.data",
      "resources/server/nlu/model/tokenizer/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-2",
          "libasound2",
          "libssl3"
        ]
      }
    },
    "copyright": "© 2026 NEXUS",
    "category": "Productivity",
    "shortDescription": "Floating desktop AI assistant (thin client)",
    "longDescription": "A cross-platform floating AI assistant that bridges to a remote n8n/Ollama backend."
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["nexus"]
      }
    }
  }
}
