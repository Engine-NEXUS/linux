# ==============================================================================
# NEXUS Assistant Environment Variables Example Template (env.example)
# Copy this file to .env and fill in your API key values.
# ==============================================================================

# ---- Fish Audio TTS (Ethan Voice Model) ----
# Obtain your API key from https://fish.audio/
# Voice ID: 536d3a5e000945adb7038665781a4aca (Ethan - s2.1-pro)
FISH_AUDIO_API_KEY=
NEXUS_FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=536d3a5e000945adb7038665781a4aca
FISH_AUDIO_MODEL=s2.1-pro

# ---- ElevenLabs TTS (Optional) ----
# Obtain your API key from https://elevenlabs.io/
ELEVENLABS_API_KEY=

# ---- Gemini 3.5 Transcribe (STT) & Gemini 3.1 Flash (TTS) ----
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
NEXUS_GEMINI_API_KEY=

# ---- Cloudflare Worker Backend URL ----
NEXUS_SERVER_URL=https://nexus-worker.your-subdomain.workers.dev
