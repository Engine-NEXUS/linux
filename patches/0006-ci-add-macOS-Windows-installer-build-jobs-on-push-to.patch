From 01c870dcb4c5da2c2148196ddc4207f2d7c60d26 Mon Sep 17 00:00:00 2001
From: Chitkul Lakshya <chitkullakshya@gmail.com>
Date: Thu, 3 Sep 2026 18:14:09 +0530
Subject: [PATCH 6/7] ci: add macOS + Windows installer build jobs on push to
 main

- macos-installer: builds .dmg on real macOS runner, uploads as artifact
- windows-installer: builds NSIS .exe + MSI, uploads as artifacts
- Both run only on push to main (not PRs) to save CI minutes
- macOS job also runs cargo test --lib (was only cargo check before)

This is the only free, legal way to test macOS builds without owning a Mac.
GitHub Actions macOS runners are real Macs on Apple hardware.

Generated with [Devin](https://devin.ai)

Co-Authored-By: Devin <158243242+devin-ai-integration[bot]@users.noreply.github.com>
---
 .github/workflows/ci.yml | 89 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 89 insertions(+)

diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 4e1409d..eff20a9 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -65,6 +65,95 @@ jobs:
         working-directory: src-tauri
         run: cargo check --features mock-wake
 
+      - name: Cargo test
+        working-directory: src-tauri
+        run: cargo test --lib
+
+  # ─── macOS installer build (tests .dmg production on real Mac) ──────
+  # This is the ONLY free, legal way to test macOS builds without owning a Mac.
+  # GitHub Actions macOS runners are real Macs hosted on Apple hardware.
+  # For private repos: macOS minutes count 10x against your 2000 min/month free tier.
+  # For public repos: unlimited free.
+  macos-installer:
+    runs-on: macos-latest
+    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: dtolnay/rust-toolchain@stable
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+          cache-dependency-path: frontend/package-lock.json
+
+      - name: Install frontend deps
+        working-directory: frontend
+        run: npm ci
+
+      - name: Build macOS installer (.dmg)
+        run: npx --yes @tauri-apps/cli build --target aarch64-apple-darwin
+        env:
+          # No code signing in CI — produces an unsigned .dmg
+          # Users will need to right-click → Open to bypass Gatekeeper
+          APPLE_SIGNING_IDENTITY: ""
+
+      - name: Upload macOS installer artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: nexus-macos-dmg
+          path: src-tauri/target/release/bundle/dmg/*.dmg
+          if-no-files-found: warn
+          retention-days: 7
+
+  # ─── Windows installer build ────────────────────────────────────────
+  windows-installer:
+    runs-on: windows-latest
+    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: dtolnay/rust-toolchain@stable
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: npm
+          cache-dependency-path: frontend/package-lock.json
+
+      - name: Install LLVM
+        run: choco install llvm -y
+
+      - name: Set LIBCLANG_PATH
+        run: echo "LIBCLANG_PATH=C:\Program Files\LLVM\bin" >> $env:GITHUB_ENV
+
+      - name: Install frontend deps
+        working-directory: frontend
+        run: npm ci
+
+      - name: Build Windows installer (.exe + .msi)
+        run: npx --yes @tauri-apps/cli build
+        env:
+          # NSIS installer + MSI installer both produced
+          TAURI_BUNDLE: "nsis,msi"
+
+      - name: Upload Windows NSIS installer
+        uses: actions/upload-artifact@v4
+        with:
+          name: nexus-windows-exe
+          path: src-tauri/target/release/bundle/nsis/*.exe
+          if-no-files-found: warn
+          retention-days: 7
+
+      - name: Upload Windows MSI installer
+        uses: actions/upload-artifact@v4
+        with:
+          name: nexus-windows-msi
+          path: src-tauri/target/release/bundle/msi/*.msi
+          if-no-files-found: warn
+          retention-days: 7
+
   rust-check-windows:
     runs-on: windows-latest
     steps:
-- 
