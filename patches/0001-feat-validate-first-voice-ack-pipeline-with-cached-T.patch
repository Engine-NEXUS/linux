+/**
+ * Shared "open architecture mapper" flow — used by both the wake-word path
+ * (finishCapture) and the VAD path (finishCaptureFromVad). Previously this
+ * ~50-line block was duplicated verbatim in both functions.
+ *
+ * Flow (validated, cached TTS, synced animations):
+ *   1. Speak "On it sir" via cached TTS (instant, <5ms)
+ *   2. Orb hides + loading shows AFTER tts:audio-started event (perfect sync)
+ *   3. Run Phase 1 + AI enrichment in background (~3-5s) while TTS plays
+ *   4. Wait for BOTH TTS and invoke to finish before hiding loading
+ *   5. Architect window opens with enriched data, speak result
+ *   6. Release captureInProgress when the assistant returns to idle
+ */
+async function handleOpenArchitect(): Promise<void> {
+  // 1. Speak "On it sir" via cached TTS — instant playback from memory
+  useAssistant.getState().setState("speaking");
+  useAssistant.getState().addAssistantMessage("On it sir, mapping the architecture...");
+  const ttsPromise = speakCached("On it sir");
+
+  // 2. Hide orb + show loading AFTER audio starts (synced via tts:audio-started event).
+  //    The event is emitted by Rust right before playback begins.
+  //    We listen for it once here, with a timeout fallback in case the event
+  //    doesn't arrive (e.g. outside Tauri or TTS fails).
+  let audioStarted = false;
+  const onAudioStarted = () => {
+    if (audioStarted) return;
+    audioStarted = true;
+    console.log("[NEXUS] architect: tts:audio-started — hiding orb + showing loading");
+    useAssistant.getState().setVisible(false);
+    setTimeout(() => useAssistant.getState().reset(), 550);
+    void showLoadingIndicator();
+  };
+
+  // Set up one-shot listener for tts:audio-started
+  let unlistenFn: (() => void) | null = null;
+  try {
+    const { listen } = await import("@tauri-apps/api/event");
+    unlistenFn = await listen<string>("tts:audio-started", () => onAudioStarted());
+  } catch {
+    // Outside Tauri — fall through to timeout fallback below
+  }
+
+  // Fallback: if tts:audio-started doesn't fire within 300ms, hide orb + show
+  // loading anyway (covers cache miss → on-demand synthesis path).
+  const fallbackTimer = setTimeout(() => {
+    if (!audioStarted) {
+      console.log("[NEXUS] architect: tts:audio-started timeout — using fallback");
+      onAudioStarted();
+    }
+  }, 300);
+
+  // 3. Run architect open flow — awaited so callers' finally blocks
+  //    don't reset captureInProgress before the window actually opens.
+  try {
+    const { invoke } = await import("@tauri-apps/api/core");
+    // Phase 1 + AI enrichment (3-5 seconds for real repo, instant for no repo)
+    const result = await invoke<number>("open_architect_with_auto_detect");
+
+    // 4. Wait for "On it sir" TTS to finish before hiding loading indicator
+    try { await ttsPromise; } catch {}
+
+    // 5. Hide loading indicator — architect window is now open
+    void hideLoadingIndicator();
+
+    // 6. Speak the appropriate response
+    if (result === 1) {
+      void speak("Here is the architecture, sir.");
+    } else if (result === 2) {
+      void speak("Found the repository, but analysis failed, sir. Opening the mapper anyway.");
+    } else {
+      void speak("Couldn't detect a repository, sir. Opening the mapper anyway.");
+    }
+  } catch (err) {
+    console.error("[NEXUS] failed to open architect window:", err);
+    try { await ttsPromise; } catch {}
+    void hideLoadingIndicator();
+    void speak("Couldn't open the architecture mapper, sir.");
+  } finally {
+    clearTimeout(fallbackTimer);
+    if (unlistenFn) { try { unlistenFn(); } catch {} }
+  }
+}
