+    return;
+  }
+
+  void emitTtsEvent("tts-started");
+  try {
+    await invoke("speak_cached", { text });
+  } catch (err) {
+    // Fallback to regular speak() if cached playback fails
+    if (ttsGeneration === myGen) {
+      console.warn("[TTS] cached speak failed, falling back to speak():", err);
+      await speak(text, onEnd);
+      return;
+    }
+  } finally {
+    void emitTtsEvent("tts-ended");
+    if (ttsGeneration === myGen) {
+      onEnd?.();
+    }
