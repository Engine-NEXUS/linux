# Dependencies
node_modules/
frontend/node_modules/

# Build outputs
frontend/dist/
src-tauri/gen/
src-tauri/target/
target/

# Admin-only brain system — ENTIRE folder gitignored.
# Only on the admin's laptop. Never committed, never shipped to users.
# Contains: brain_server.py, Qwen GGUF model (398MB), pronunciation map,
# gaps/approved/rejected training data, admin config.
server/admin/
src-tauri/server/admin/
server/nlu/audit_report.json
server/nlu/data/staging/*.jsonl
server/nlu/data/staging/*.json
server/nlu/data/downloads/

# Reference repo for Windows 11 Start Menu theme research (liquidglass, aero, etc.)
# Cloned from https://github.com/ramensoftware/windows-11-start-menu-styling-guide
# Used as reference only — never commit, never ship.
reference_startmenu_themes/

# Brain debug output
brain_stdout.txt
brain_stderr.txt

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Credentials / secrets (never commit these)
*.db
*.db-journal
.env
.env.*
!env.example
secrets.json
credentials.json

# Machine-specific generated launchers.
# start_stt.cmd embeds an absolute path to the local Python interpreter
# (e.g. C:\Users\<name>\AppData\Local\Programs\Python\...\pythonw.exe),
# so it is valid on exactly one machine and leaks the username.
server/start_stt.cmd
server/start_*.cmd
server/start_*.sh

# Tauri
src-tauri/WixTools/

# Logs
*.log
logs/

# Porcupine native libraries (platform-specific, downloaded per-machine)
src-tauri/resources/porcupine/*.dll
src-tauri/resources/porcupine/*.dylib
src-tauri/resources/porcupine/*.so
src-tauri/resources/porcupine/*.ppn
src-tauri/resources/porcupine/*.pv

# Whisper model files (too large for git, download separately)
src-tauri/resources/whisper/*.bin

# Lock files (cargo generates Cargo.lock; npm uses package-lock.json)
frontend/yarn.lock

# Experiment / scratch projects (not part of NEXUS)
experiment/

# Stray Lottie / animation assets dropped in the repo root while iterating on
# the orb. Anything actually used by the UI belongs in frontend/public/.
/*.lottie

# Training artifacts (scratch outputs, logs, temporary scripts)
