# Dependencies
node_modules/
frontend/node_modules/

# Build outputs
frontend/dist/
src-tauri/gen/
src-tauri/target/
target/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Credentials / secrets (never commit these)
*.db
*.db-journal
.env
.env.*
!env.example
secrets.json
credentials.json

# Machine-specific generated launchers.
# start_stt.cmd embeds an absolute path to the local Python interpreter
# (e.g. C:\Users\<name>\AppData\Local\Programs\Python\...\pythonw.exe),
# so it is valid on exactly one machine and leaks the username.
server/start_stt.cmd
server/start_*.cmd
server/start_*.sh

# Tauri
src-tauri/WixTools/

# Logs
*.log
logs/

# Porcupine native libraries (platform-specific, downloaded per-machine)
src-tauri/resources/porcupine/*.dll
src-tauri/resources/porcupine/*.dylib
src-tauri/resources/porcupine/*.so
src-tauri/resources/porcupine/*.ppn
src-tauri/resources/porcupine/*.pv

# Whisper model files (too large for git, download separately)
src-tauri/resources/whisper/*.bin

# Lock files (cargo generates Cargo.lock; npm uses package-lock.json)
frontend/yarn.lock

# Experiment / scratch projects (not part of NEXUS)
experiment/

# Stray Lottie / animation assets dropped in the repo root while iterating on
# the orb. Anything actually used by the UI belongs in frontend/public/.
/*.lottie

# Training artifacts (scratch outputs, logs, temporary scripts)
# The trained model lives in src-tauri/resources/oww/nexus.onnx
training/archive/
training/scripts/

# Training notebooks and research PDFs (machine-specific)
training/
docs/research/
*.ipynb

# Temporary CDP debug scripts
scripts/cdp_*.js
scripts/check_*.js
scripts/test_*.js
scripts/show_*.js
scripts/debug_*.js
scripts/test_*.ps1
scripts/collect_wake_samples.py

# Temporary root-level debug/test files
check-css-var.cjs
deep-debug.cjs
reshow.cjs
show-blur-test*.cjs
show-demo.cjs
check_mic.ps1
test_*.py
test_*.wav
list_*.py
gen_tts.py
demo-v3.png
live_mic_5s.wav
mic_test_dev21.wav

# Kaggle training output (machine-specific)
kaggle_nexus_v2/

# Backup model files
src-tauri/resources/oww/*.backup

# Test/example directories
src-tauri/examples/
src-tauri/src/test_wda.rs

# NLU training outputs (only the runtime ONNX model + tokenizer are committed;
# the PyTorch checkpoint and any future training artifacts are ignored).
server/nlu/model/best_model.pt
server/nlu/model/*.pt
server/nlu/model/*.ckpt
server/nlu/__pycache__/

# Training dataset archives
results.zip
nexus_real_samples/*.zip
gen_sapi.ps1
