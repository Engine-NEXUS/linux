# NEXUS Sidecar Environment Variables
# Copy this file to .env and fill in your values.
#
# TEXT-ONLY PROTOCOL:
#   STT and TTS are now done locally on the client device.
#   The sidecar only receives transcript text and returns result text.
#   No audio crosses the network.

# ---- Cloudflare Worker (replaces n8n) ----
# After deploying the Worker (cd server/worker && npx wrangler deploy),
# set this to the Worker URL printed by wrangler.
# For local dev: http://localhost:8785
NEXUS_WORKER_URL=https://nexus-worker.your-subdomain.workers.dev
NEXUS_WORKER_TOKEN=

# ---- Google OAuth ----
# Create at https://console.cloud.google.com/apis/credentials
# Application type: Web application (the sidecar exchanges the code)
# Redirect URI: nexus://oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- GitHub App ----
# Create at https://github.com/settings/apps → New GitHub App
# Authorization callback URL: nexus://oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- OAuth Redirect ----
# Must match what's registered in Google Cloud Console and GitHub App
OAUTH_REDIRECT_URI=nexus://oauth/callback

# ---- Security ----
# Optional bearer gate on the /ws WebSocket endpoint
NEXUS_SIDECAR_TOKEN=
# Fernet encryption key for API keys at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NEXUS_ENCRYPTION_KEY=

# ---- Database ----
NEXUS_DB_PATH=nexus_credentials.db

# ---- Server ----
SIDECAR_HOST=0.0.0.0
SIDECAR_PORT=8443

