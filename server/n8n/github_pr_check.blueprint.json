{
  "name": "github.pr_check",
  "active": true,
  "settings": { "executionOrder": "v1" },
  "_meta": {
    "description": "Check open GitHub PRs for a repository. Receives credentials + args from the master supervisor.",
    "trigger": "Execute Workflow (called by master supervisor)",
    "input": {
      "credentials": { "github": { "access_token": "string" } },
      "args": { "repo": "string (e.g. 'Engine-NEXUS/NEXUS-Agent')" }
    },
    "output": { "summary": "string", "pr_count": "number", "findings": "array" },
    "required_credentials": ["github"]
  },
  "nodes": [
    {
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "parameters": {},
      "position": [0, 0]
    },
    {
      "name": "Extract Args",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst creds = input.credentials || {};\nconst githubToken = creds.github?.access_token || '';\nconst args = input.args || {};\nconst repo = args.repo || 'Engine-NEXUS/NEXUS-Agent';\nif (!githubToken) throw new Error('GitHub not connected — ask user to connect GitHub in setup');\nreturn [{ json: { access_token: githubToken, repo: repo } }];"
      },
      "position": [220, 0]
    },
    {
      "name": "Fetch Open PRs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/repos/{{ $json.repo }}/pulls",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "state", "value": "open" },
            { "name": "sort", "value": "updated" },
            { "name": "direction", "value": "desc" },
            { "name": "per_page", "value": "10" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $json.access_token }}" },
            { "name": "Accept", "value": "application/vnd.github+json" },
            { "name": "X-GitHub-Api-Version", "value": "2022-11-28" }
          ]
        }
      },
      "position": [440, 0]
    },
    {
      "name": "Build PR Summary Input",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const prs = $input.all().map(item => {\n  const pr = item.json;\n  return `PR #${pr.number}: ${pr.title}\\n  Author: ${pr.user?.login || 'unknown'}\\n  Updated: ${pr.updated_at}\\n  Draft: ${pr.draft ? 'yes' : 'no'}\\n  Labels: ${(pr.labels || []).map(l => l.name).join(', ') || 'none'}\\n`;\n}).join('\\n---\\n');\nreturn [{ json: { prs_text: prs || 'No open PRs found.', count: $input.all().length } }];"
      },
      "position": [660, 0]
    },
    {
      "name": "Analyze with Ollama",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "http://localhost:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "model": "llama3.1:8b-instruct-q4_k_m",
          "stream": false,
          "messages": [
            { "role": "system", "content": "You are NEXUS. Analyze the open GitHub PRs. For each PR, note: title, author, whether it's a draft, and any concerning labels. Highlight PRs that may need attention. Be concise." },
            { "role": "user", "content": "={{ $json.prs_text }}" }
          ]
        }
      },
      "position": [880, 0]
    },
    {
      "name": "Return Result",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const summary = $input.first().json.message?.content || '';\nconst count = $('Build PR Summary Input').item.json.count;\nreturn [{ json: { summary: summary, pr_count: count } }];"
      },
      "position": [1100, 0]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": { "main": [ [ { "node": "Extract Args", "type": "main", "index": 0 } ] ] },
    "Extract Args": { "main": [ [ { "node": "Fetch Open PRs", "type": "main", "index": 0 } ] ] },
    "Fetch Open PRs": { "main": [ [ { "node": "Build PR Summary Input", "type": "main", "index": 0 } ] ] },
    "Build PR Summary Input": { "main": [ [ { "node": "Analyze with Ollama", "type": "main", "index": 0 } ] ] },
    "Analyze with Ollama": { "main": [ [ { "node": "Return Result", "type": "main", "index": 0 } ] ] }
  }
}
