{
  "name": "email.summarize",
  "active": true,
  "settings": { "executionOrder": "v1" },
  "_meta": {
    "description": "Summarize recent Gmail messages. Receives credentials + args from the master supervisor.",
    "trigger": "Execute Workflow (called by master supervisor)",
    "input": {
      "credentials": { "google": { "access_token": "string" } },
      "args": { "since": "string (default: 24h)" }
    },
    "output": { "summary": "string", "email_count": "number" },
    "required_credentials": ["google"]
  },
  "nodes": [
    {
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "parameters": {},
      "position": [0, 0]
    },
    {
      "name": "Extract Args",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst creds = input.credentials || {};\nconst googleToken = creds.google?.access_token || '';\nconst args = input.args || {};\nconst since = args.since || '24h';\nif (!googleToken) throw new Error('Google not connected — ask user to connect Google in setup');\nreturn [{ json: { access_token: googleToken, since: since } }];"
      },
      "position": [220, 0]
    },
    {
      "name": "Fetch Recent Emails",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/messages",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "maxResults", "value": "10" },
            { "name": "q", "value": "={{ 'newer_than:1d' }}" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $json.access_token }}" }
          ]
        },
        "_note": "Fetches last 10 messages from the past day. Adjust q parameter based on args.since."
      },
      "position": [440, 0]
    },
    {
      "name": "Fetch Each Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/messages/{{ $json.id }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "format", "value": "metadata" },
            { "name": "metadataHeaders", "value": "Subject" },
            { "name": "metadataHeaders", "value": "From" },
            { "name": "metadataHeaders", "value": "Date" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $('Extract Args').item.json.access_token }}" }
          ]
        },
        "_note": "Loop over each message ID. In n8n, this node runs once per item automatically."
      },
      "position": [660, 0]
    },
    {
      "name": "Build Summary Input",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const emails = $input.all().map(item => {\n  const msg = item.json;\n  const headers = msg.payload?.headers || [];\n  const subject = headers.find(h => h.name === 'Subject')?.value || '(no subject)';\n  const from = headers.find(h => h.name === 'From')?.value || 'unknown';\n  const date = headers.find(h => h.name === 'Date')?.value || '';\n  return `From: ${from}\\nDate: ${date}\\nSubject: ${subject}\\n`;\n}).join('\\n---\\n');\nreturn [{ json: { emails_text: emails, count: $input.all().length } }];"
      },
      "position": [880, 0]
    },
    {
      "name": "Summarize with Ollama",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "http://localhost:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "model": "llama3.1:8b-instruct-q4_k_m",
          "stream": false,
          "messages": [
            { "role": "system", "content": "You are NEXUS. Summarize the user's recent emails concisely. Highlight important items, action items, and anything urgent. Be brief but complete." },
            { "role": "user", "content": "={{ $json.emails_text }}" }
          ]
        }
      },
      "position": [1100, 0]
    },
    {
      "name": "Return Result",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const summary = $input.first().json.message?.content || '';\nconst count = $('Build Summary Input').item.json.count;\nreturn [{ json: { summary: summary, email_count: count } }];"
      },
      "position": [1320, 0]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": { "main": [ [ { "node": "Extract Args", "type": "main", "index": 0 } ] ] },
    "Extract Args": { "main": [ [ { "node": "Fetch Recent Emails", "type": "main", "index": 0 } ] ] },
    "Fetch Recent Emails": { "main": [ [ { "node": "Fetch Each Email", "type": "main", "index": 0 } ] ] },
    "Fetch Each Email": { "main": [ [ { "node": "Build Summary Input", "type": "main", "index": 0 } ] ] },
    "Build Summary Input": { "main": [ [ { "node": "Summarize with Ollama", "type": "main", "index": 0 } ] ] },
    "Summarize with Ollama": { "main": [ [ { "node": "Return Result", "type": "main", "index": 0 } ] ] }
  }
}
