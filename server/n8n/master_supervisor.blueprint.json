{
  "name": "NEXUS Master Supervisor",
  "active": true,
  "settings": { "executionOrder": "v1" },
  "_meta": {
    "description": "Master intent router. Receives transcript + credentials from the sidecar, classifies intent with a fast LLM, dispatches to a sub-canvas, returns result text. The sidecar handles TTS (ElevenLabs) and streaming — n8n only does intent routing + domain work.",
    "webhook": "POST /supervisor",
    "input": {
      "transcript": "string",
      "userId": "string",
      "deviceId": "string",
      "sessionId": "string",
      "credentials": {
        "google": { "access_token": "string", "scopes": "string" },
        "github": { "access_token": "string" },
        "api_keys": { "claude": "string", "devin": "string" }
      }
    },
    "output": "JSON: { reply_text: string, intent: string, context: object }",
    "concurrency": "OLLAMA_NUM_PARALLEL=1; sub-canvases guarded by Redis mutex for <=5 users",
    "models": {
      "router": "qwen2.5:1.5b-instruct-q4_k_m",
      "heavy": "llama3.1:8b-instruct-q4_k_m"
    },
    "auth": "Per-device tokens validated by the sidecar before calling this webhook. The sidecar forwards the bearer token in the Authorization header.",
    "tts": "Handled by the sidecar (ElevenLabs multi-context). n8n returns text only."
  },
  "nodes": [
    {
      "name": "Webhook In",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "supervisor",
        "responseMode": "responseNode",
        "options": { "rawBody": true }
      },
      "position": [0, 0]
    },
    {
      "name": "Parse Body",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nreturn [{ json: {\n  transcript: body.transcript || '',\n  userId: body.userId || '',\n  deviceId: body.deviceId || '',\n  sessionId: body.sessionId || '',\n  credentials: body.credentials || {}\n} }];"
      },
      "position": [220, 0]
    },
    {
      "name": "Classify Intent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "http://localhost:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "model": "qwen2.5:1.5b-instruct-q4_k_m",
          "stream": false,
          "options": { "temperature": 0.0, "num_predict": 96 },
          "format": {
            "type": "object",
            "properties": {
              "intent": { "type": "string", "enum": ["email.summarize", "github.pr_check", "calendar.peek", "general.chat"] },
              "confidence": { "type": "number" },
              "args": { "type": "object" }
            },
            "required": ["intent"]
          },
          "messages": [
            { "role": "system", "content": "You are the NEXUS intent router. Output ONLY JSON matching the schema. Pick the single best intent. 'args' carries parsed entities (e.g. {since:'24h', repo:'NEXUS'}). Available intents: email.summarize (Gmail), github.pr_check (GitHub PRs), calendar.peek (Google Calendar), general.chat (anything else)." },
            { "role": "user", "content": "={{ $json.transcript }}" }
          ]
        }
      },
      "position": [440, 0]
    },
    {
      "name": "Parse Intent",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const raw = $input.first().json.message?.content ?? $input.first().json;\nlet p;\ntry { p = JSON.parse(raw); } catch { p = { intent: 'general.chat', confidence: 0.5, args: {} }; }\nif (p.confidence < 0.5) p.intent = 'general.chat';\n// Preserve credentials + transcript for downstream nodes\np.credentials = $('Parse Body').item.json.credentials;\np.transcript = $('Parse Body').item.json.transcript;\np.sessionId = $('Parse Body').item.json.sessionId;\nreturn [{ json: p }];"
      },
      "position": [660, 0]
    },
    {
      "name": "Route",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.1,
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.intent }}",
        "fallbackOutput": 3,
        "rules": {
          "rules": [
            { "value2": { "string": { "value": "email.summarize" } } },
            { "value2": { "string": { "value": "github.pr_check" } } },
            { "value2": { "string": { "value": "calendar.peek" } } }
          ]
        }
      },
      "position": [880, 0]
    },
    {
      "name": "email.summarize",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "parameters": { "workflowId": "EMAIL_SUMMARY_WF_ID" },
      "position": [1100, -200]
    },
    {
      "name": "github.pr_check",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "parameters": { "workflowId": "GITHUB_PR_WF_ID" },
      "position": [1100, 0]
    },
    {
      "name": "calendar.peek",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "parameters": { "workflowId": "CALENDAR_WF_ID" },
      "position": [1100, 200]
    },
    {
      "name": "general.chat",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "http://localhost:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": {
          "model": "llama3.1:8b-instruct-q4_k_m",
          "stream": false,
          "messages": [
            { "role": "user", "content": "={{ $json.transcript }}" }
          ]
        }
      },
      "position": [1100, 400]
    },
    {
      "name": "Aggregate",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst reply = input.message?.content || input.reply_text || input.summary || input.result || '';\nconst intent = $('Parse Intent').item.json.intent;\nreturn [{ json: { reply_text: reply, intent: intent, context: input } }];"
      },
      "position": [1320, 100]
    },
    {
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      },
      "position": [1540, 100]
    }
  ],
  "connections": {
    "Webhook In": { "main": [ [ { "node": "Parse Body", "type": "main", "index": 0 } ] ] },
    "Parse Body": { "main": [ [ { "node": "Classify Intent", "type": "main", "index": 0 } ] ] },
    "Classify Intent": { "main": [ [ { "node": "Parse Intent", "type": "main", "index": 0 } ] ] },
    "Parse Intent": { "main": [ [ { "node": "Route", "type": "main", "index": 0 } ] ] },
    "Route": { "main": [
      [ { "node": "email.summarize", "type": "main", "index": 0 } ],
      [ { "node": "github.pr_check", "type": "main", "index": 0 } ],
      [ { "node": "calendar.peek", "type": "main", "index": 0 } ],
      [ { "node": "general.chat", "type": "main", "index": 0 } ]
    ] },
    "email.summarize": { "main": [ [ { "node": "Aggregate", "type": "main", "index": 0 } ] ] },
    "github.pr_check": { "main": [ [ { "node": "Aggregate", "type": "main", "index": 0 } ] ] },
    "calendar.peek": { "main": [ [ { "node": "Aggregate", "type": "main", "index": 0 } ] ] },
    "general.chat": { "main": [ [ { "node": "Aggregate", "type": "main", "index": 0 } ] ] },
    "Aggregate": { "main": [ [ { "node": "Respond", "type": "main", "index": 0 } ] ] }
  }
}
